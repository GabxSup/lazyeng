# Copy to bridge.env and fill in. This file is read by mt5_bridge.py.
# Bind to loopback. Reach it from Docker over an SSH tunnel, not the public internet.
BRIDGE_HOST=127.0.0.1
BRIDGE_PORT=8765
BRIDGE_TOKEN=replace-with-a-long-random-token
MT5_SYMBOL=XAUUSD

# Use the MT5 demo account for initial integration testing.
MT5_LOGIN=12345678
MT5_PASSWORD=your-mt5-password
MT5_SERVER=YourBroker-Demo
# Optional. Use the actual terminal path if initialize() cannot find it.
MT5_PATH=C:\Program Files\MetaTrader 5\terminal64.exe

# Real-money execution stays blocked unless this is true AND the armed
# dashboard sends the live confirmation header.
BRIDGE_ALLOW_LIVE=false
BRIDGE_MAGIC=20261101
BRIDGE_LOG_LEVEL=INFO
