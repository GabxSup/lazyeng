# ── AURUM AI configuration ────────────────────────────────────────────────
# Copy to .env, or run ./setup.sh to generate a secure local file.
AURUM_HOST=127.0.0.1
AURUM_PORT=8080
AURUM_DATA_DIR=./data

# Required. Use a long random value. setup.sh generates one for you.
AURUM_DASHBOARD_PASSWORD=replace-with-a-long-password
AURUM_SECRET_KEY=replace-with-64-random-hex-characters
AURUM_COOKIE_SECURE=false

# Paper account
AURUM_PAPER_BALANCE=10000
AURUM_SYMBOL=XAUUSD

# ── Live MT5 / MT4 terminals ───────────────────────────────────────────────
# Live execution is disabled unless this is true AND you type the arm phrase.
AURUM_LIVE_ENABLED=false
AURUM_LIVE_ARM_PHRASE=ARM LIVE TRADING
AURUM_BRIDGE_URL=http://127.0.0.1:8765
AURUM_BRIDGE_TOKEN=
AURUM_BRIDGE_TIMEOUT=6

# Shared secret for the MT4 Expert Advisor; set the same value in InpToken.
AURUM_EA_TOKEN=

# ── Optional AI analyst (OpenAI-compatible) ──────────────────────────────
# Leave the key empty for quant-only mode. The analyst can veto, never size.
AURUM_AI_API_KEY=
AURUM_AI_BASE_URL=https://api.openai.com/v1
AURUM_AI_MODEL=gpt-4o-mini
AURUM_AI_TIMEOUT=12

AURUM_LOG_LEVEL=INFO
